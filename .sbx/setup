#!/usr/bin/env bash
# Python 3.12 venv for the control service, the web app built into
# control/sbx_control/web_dist, and the dev installation's runtime.env.
# Safe to repeat: installs are skipped while their lockfiles are unchanged.
set -euo pipefail
cd "$SBX_WORKDIR"
export PATH="/usr/local/bin:$PATH"   # the base template's Node 22, ahead of an image's own
dev="$HOME/.sbx-dev"
mkdir -p "$dev/etc" "$dev/state" "$dev/run" "$dev/systemd"

python3 -c 'import sys; assert sys.version_info[:2] >= (3, 12), sys.version'
stamp=$(sha256sum control/requirements.txt | cut -c1-16)
if [ ! -x "$dev/venv/bin/uvicorn" ] || [ "$(cat "$dev/venv/.stamp" 2>/dev/null)" != "$stamp" ]; then
  python3 -m venv "$dev/venv"
  "$dev/venv/bin/pip" install --quiet --disable-pip-version-check -r control/requirements.txt
  echo "$stamp" > "$dev/venv/.stamp"
fi

echo "node $(node -v), npm $(npm -v)"
stamp=$(sha256sum web/package-lock.json | cut -c1-16)
if [ ! -d web/node_modules ] || [ "$(cat web/node_modules/.sbx-stamp 2>/dev/null)" != "$stamp" ]; then
  npm --prefix web ci --no-audit --no-fund
  echo "$stamp" > web/node_modules/.sbx-stamp
fi
npm --prefix web run build

# The dev installation's sandbox runtime: Boat with the owner's key, else none yet.
umask 077
if [ -n "${BOAT_API_KEY:-}" ]; then
  printf 'SBX_RUNTIMES=boat\nSBX_RUNTIME_DEFAULT=boat\nBOAT_API_KEY=%s\n' "$BOAT_API_KEY" > "$dev/etc/runtime.env.new"
else
  echo "BOAT_API_KEY is not set: the dev installation starts without a sandbox runtime"
  printf 'SBX_RUNTIMES=\n' > "$dev/etc/runtime.env.new"
fi
mv "$dev/etc/runtime.env.new" "$dev/etc/runtime.env"
echo "sbx dev installation ready in $dev"

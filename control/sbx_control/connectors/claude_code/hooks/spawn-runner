#!/usr/bin/env python3
"""spawn-runner hook of claude-orchestrator.service: hand the order to
sbx-control, which records it and provisions in the background.

Exit codes per the orchestrator's contract: 0 accepted, 1 retryable
(sbx-control unreachable or failing), 2 never servable (sbx-control
rejected the order). stderr reaches the environment's Activity tab, so
it never carries the work order or the account email. Standard library
only: the orchestrator runs it with the host's python3.
"""
import json
import os
import sys
import urllib.error
import urllib.request

FIELDS = ["order_id", "session_id", "session_uuid", "account_email", "primary_repo_url", "primary_repo_revision"]

order = {field: os.environ.get(f"CLAUDE_RUNNER_{field.upper()}", "") for field in FIELDS}
with open(os.environ["CLAUDE_RUNNER_WORK_ORDER_FILE"]) as f:
    order["work_order"] = f.read().strip()
# The orchestrator's unit sets the port (platform.CONTROL_PORT); its hooks inherit its env.
port = os.environ.get("SBX_CONTROL_PORT", "8080")
request = urllib.request.Request(f"http://127.0.0.1:{port}/internal/runner-orders", data=json.dumps(order).encode(),
                                 headers={"content-type": "application/json"})
try:
    with urllib.request.urlopen(request, timeout=40) as response:
        print(f"order {order['order_id']}: {json.load(response)['status']}")
except urllib.error.HTTPError as error:
    body = error.read().decode(errors="replace")[:500]
    try:
        body = json.loads(body).get("detail", body)
    except ValueError:
        pass
    print(body if error.code == 503 else f"sbx-control answered {error.code}: {body}", file=sys.stderr)
    sys.exit(2 if error.code in (400, 422) else 1)
except OSError as error:
    print(f"sbx-control unreachable: {error}", file=sys.stderr)
    sys.exit(1)

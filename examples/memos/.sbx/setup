#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/node/bin:$HOME/.local/go/bin:$PATH"
version=$(awk '$1=="go" {print $2;exit}' go.mod)
python3 /run/sbx/app/toolchains.py --node-major 24 --go "$version"
pnpm_version=$(python3 -c 'import json;print(json.load(open("web/package.json"))["packageManager"].split("@")[1])')
if [ ! -x "$HOME/.local/bin/pnpm" ] || [ "$("$HOME/.local/bin/pnpm" --version)" != "$pnpm_version" ]; then
  npm install --global --prefix "$HOME/.local" --no-audit --no-fund "pnpm@$pnpm_version"
fi
"$HOME/.local/bin/pnpm" --dir web install --frozen-lockfile
"$HOME/.local/bin/pnpm" --dir web release
mkdir -p build "$MEMOS_DATA"
GOMAXPROCS=2 GOMEMLIMIT=2GiB go build -p 2 -o build/memos ./cmd/memos
printf 'Memos source build is ready\n'

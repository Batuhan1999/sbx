#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/node/bin:$PATH"
python3 /run/sbx/app/toolchains.py --node-major 24
pnpm_version=$(python3 -c 'import json;print(json.load(open("package.json"))["engines"]["pnpm"])')
if [ ! -x "$HOME/.local/bin/pnpm" ] || [ "$("$HOME/.local/bin/pnpm" --version)" != "$pnpm_version" ]; then
  npm install --global --prefix "$HOME/.local" --no-audit --no-fund "pnpm@$pnpm_version"
fi
"$HOME/.local/bin/pnpm" install --frozen-lockfile
NODE_OPTIONS=--max-old-space-size=4096 "$HOME/.local/bin/pnpm" build
node /run/sbx/app/bootstrap.mjs
printf 'Umami source build and isolated database are ready\n'

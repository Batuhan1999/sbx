#!/usr/bin/env bash
# Prepares an Amp orb to develop sbx: Python 3.12 in .venv with the dev
# requirements, Node 22 with the web app's dependencies, and the web bundle
# the control tests and release packaging need. Matches .github/workflows/check.yml.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local name="$1"; shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "    $name took $((SECONDS - start))s"
}

node_major=22
node_dir="$HOME/.local/node-$node_major"

install_node() {
  if [ -x "$node_dir/bin/node" ]; then
    echo "    node $("$node_dir/bin/node" --version) already installed"
    return
  fi
  local version tmp
  version="$(curl -fsSL "https://nodejs.org/dist/latest-v$node_major.x/SHASUMS256.txt" \
    | grep -o "node-v$node_major\.[0-9.]*-linux-x64\.tar\.xz" | head -n1)"
  tmp="$(mktemp -d)"
  curl -fsSL "https://nodejs.org/dist/latest-v$node_major.x/$version" -o "$tmp/$version"
  mkdir -p "$node_dir"
  tar -xJf "$tmp/$version" -C "$node_dir" --strip-components=1
  rm -rf "$tmp"
}

persist_node_path() {
  local marker="# sbx: Node $node_major for the web app"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$marker
case ":\$PATH:" in
  *":$node_dir/bin:"*) ;;
  *) export PATH="$node_dir/bin:\$PATH" ;;
esac
EOF
  fi
}

python_deps() {
  if [ ! -x .venv/bin/python ] || ! .venv/bin/python -c 'import sys; sys.exit(sys.version_info[:2] != (3, 12))'; then
    uv venv --quiet --clear --python 3.12 .venv
  fi
  uv pip install --quiet --python .venv/bin/python -r requirements-dev.txt
}

web_deps() {
  # npm ci always wipes node_modules; skip it when the lockfile and Node are unchanged.
  local stamp="web/node_modules/.sbx-setup-stamp" want
  want="$(node --version) $(sha256sum web/package-lock.json | cut -d' ' -f1)"
  if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$want" ]; then
    echo "    web/node_modules matches package-lock.json"
    return
  fi
  npm --prefix web ci --no-audit --no-fund
  echo "$want" > "$stamp"
}

step "Node $node_major" install_node
step "Node PATH in ~/.bash_profile" persist_node_path
export PATH="$node_dir/bin:$PATH"
step "Python 3.12 venv and dev requirements" python_deps
step "Web app dependencies" web_deps
# The control tests and control/release.sh need the built bundle (git ignores it).
step "Web app build" npm --prefix web run build --silent
